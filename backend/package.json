{
  "name": "crc-msg-board",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Workers + D1 backend for the RandomCreation message board",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "db:init": "wrangler d1 execute crc_msg_board --file=schema.sql --remote",
    "db:local": "wrangler d1 execute crc_msg_board --file=schema.sql --local",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.42.0"
  }
}
